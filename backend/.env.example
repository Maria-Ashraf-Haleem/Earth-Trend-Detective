SQL_SERVER=localhost
SQL_DATABASE=earthtrend_db
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_ENCRYPT=true
# Local Developer Edition may use a self-signed certificate. Set true only locally.
SQL_TRUST_SERVER_CERTIFICATE=false
SQL_TIMEOUT=10
# Separate driver-enforced SQL statement deadline; seconds, 1..600.
SQL_QUERY_TIMEOUT=60
POOL_SIZE=5
CORS_ORIGINS=["http://localhost:5173"]
# Set a random secret to enable POST /api/v1/imports; pass it as X-Import-Key.
# IMPORT_API_KEY=
DATA_FILE_PATH=C:/Users/abdel/Downloads/Earth Trend/EarthTrend_Unified/spatial_fusion_v2_fixed/earthtrend_spatial_fusion_v2.csv
AUDIT_FILE_PATH=C:/Users/abdel/Downloads/Earth Trend/EarthTrend_Unified/spatial_fusion_v2_fixed/spatial_fusion_audit.json
IMPORT_BATCH_SIZE=2000
LOG_LEVEL=INFO

# --- Optional model integration ------------------------------------------------
# No model is trained or installed. Keep MODEL_ENABLED=false until a real
# inference provider exists; observed-data endpoints never depend on it.
MODEL_ENABLED=false
# Provider kinds: http (any JSON inference service) or local (future artifact).
MODEL_PROVIDER=
MODEL_NAME=
MODEL_VERSION=
# Full URL for the http provider, e.g. http://model-server.internal/predict
MODEL_ENDPOINT=
# Bearer token for the http provider; stays on the backend, never the browser.
# MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=60
# Feature source exposed by the database view used for model inputs.
MODEL_FEATURE_VERSION=ml_features_v1
